# =============================================================================
# TradingAgents .env Configuration
# =============================================================================
# Copy file này thành .env rồi điền giá trị thật.
# =============================================================================


# ---------------------------------------------------------------------------
# 1. LLM PROVIDER — REQUIRED (chỉ cần điền 1 trong 2)
# ---------------------------------------------------------------------------
# Cả MiniMax và DeepSeek đều chạy được toàn bộ luồng phân tích.
# MiniMax dùng MCP web_search (nhiều nguồn hơn), DeepSeek dùng webfetch (đơn giản hơn).
# Điền API key cho MỘT trong hai option bên dưới.

# Option A: MiniMax
MINIMAX_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MINIMAX_CN_API_KEY=
# MINIMAX_BASE_URL=https://api.minimax.io/anthropic

# Option B: DeepSeek V4 Flash qua OpenCode (recommended)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_BASE_URL=https://opencode.ai/zen/go/v1


# ---------------------------------------------------------------------------
# 2. COINGLASS — REQUIRED (dữ liệu on-chain để phân tích chính xác)
# ---------------------------------------------------------------------------
# CoinGlass cung cấp dữ liệu on-chain realtime: exchange reserves, liquidation,
# funding rate, open interest, institutional flow. Rất quan trọng cho Onchain Analyst.

COINGLASS_API_KEY=xxxx-xxxx-xxxx-xxxx
# COINGLASS_BASE_URL=https://open-api-v4.coinglass.com


# ---------------------------------------------------------------------------
# 3. GOOGLE AUTH — REQUIRED (đăng nhập frontend)
# ---------------------------------------------------------------------------

GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_ALLOWED_EMAIL=you@gmail.com
# ADMIN_EMAILS=admin@gmail.com


# ---------------------------------------------------------------------------
# 4. TURSO DATABASE — REQUIRED (lưu lịch sử phân tích)
# ---------------------------------------------------------------------------
# Lưu kết quả phân tích, history replay, và structured decision vào Turso.

TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ---------------------------------------------------------------------------
# 5. DEPLOYMENT / CORS — Cấu hình khi deploy production
# ---------------------------------------------------------------------------

# CORS_ALLOW_ORIGINS=https://your-frontend.vercel.app
# PORT=8000


# ---------------------------------------------------------------------------
# 6. RUNTIME TUNING — Optional (đã có default hợp lý)
# ---------------------------------------------------------------------------

# LOG_LEVEL=INFO
# ANALYSIS_MAX_CONCURRENT_RUNS=1
# ANALYSIS_TRACE_CHAR_LIMIT=0
# ANALYSIS_VERBOSE_RUNTIME_LOGS=true
# DEFAULT_RESEARCH_DEPTH=auto
# HISTORY_PAGE_SIZE=10
# DEFAULT_HISTORY_ACCESS_DAYS=7


# ---------------------------------------------------------------------------
# 7. MINIMAX MCP — Optional (chỉ áp dụng khi dùng MiniMax)
# ---------------------------------------------------------------------------

# MINIMAX_MCP_ENABLED=true
# MINIMAX_MCP_COMMAND=uvx
# MINIMAX_MCP_ARGS=minimax-coding-plan-mcp -y
# MINIMAX_MCP_TOOL_NAMES=web_search
# MINIMAX_MCP_MAX_TOOL_ROUNDS=6
# MINIMAX_MCP_TOOL_RESULT_CHAR_LIMIT=0
# MINIMAX_MCP_CALL_TIMEOUT_SECONDS=90
# MINIMAX_MCP_LIST_TIMEOUT_SECONDS=45


# ---------------------------------------------------------------------------
# 8. TRADINGVIEW CHART — Optional
# ---------------------------------------------------------------------------

# TRADING_VIEW_SYMBOL=BINANCE:BTCUSDT
# TRADING_VIEW_INTERVAL=60
# TRADING_VIEW_SYMBOLS=BINANCE:BTCUSDT,BINANCE:ETHUSDT,BINANCE:SOLUSDT,BINANCE:XRPUSDT


# ---------------------------------------------------------------------------
# 9. TRADINGAGENTS INTERNAL — Advanced (không cần thay đổi)
# ---------------------------------------------------------------------------

# TRADINGAGENTS_LLM_PROVIDER=openai
# TRADINGAGENTS_OUTPUT_LANGUAGE=English
# TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
# TRADINGAGENTS_MAX_RISK_ROUNDS=1
# TRADINGAGENTS_ANALYST_CONCURRENCY_LIMIT=4
# TRADINGAGENTS_CHECKPOINT_ENABLED=false
