# LLM provider
MINIMAX_API_KEY=your_minimax_api_key_here
# MINIMAX_CN_API_KEY=your_minimax_cn_api_key_here
# MINIMAX_BASE_URL=https://api.minimax.io/anthropic
# MINIMAX_MODEL=MiniMax-M2.7

# MiniMax MCP web/search tools, optional but enabled by default for MiniMax analysis
# MINIMAX_MCP_ENABLED=true
# MINIMAX_MCP_COMMAND=uvx
# MINIMAX_MCP_ARGS=minimax-coding-plan-mcp -y
# MINIMAX_MCP_TOOL_NAMES=web_search,understand_image
# MINIMAX_MCP_MAX_TOOL_ROUNDS=4
# Optional override. In the main analysis flow, research_depth maps to MCP rounds:
# quick=2, medium=4, deep=6.
# MINIMAX_MCP_TOOL_RESULT_CHAR_LIMIT=0
# Set to 0 to disable MCP tool-result truncation before feeding it back to the model.
# MINIMAX_MCP_CALL_TIMEOUT_SECONDS=90
# MINIMAX_MCP_LIST_TIMEOUT_SECONDS=45

# Google sign-in gate
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# ADMIN_EMAILS=admin@example.com
# AUTH_RESTRICT_TO_ALLOWED_EMAILS=false
# GOOGLE_ALLOWED_EMAIL=you@example.com
# GOOGLE_ALLOWED_EMAILS=you@example.com,teammate@example.com

# Turso history persistence, optional
# TURSO_DATABASE_URL=libsql://your-database-org.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Deployment / CORS
# CORS_ALLOW_ORIGINS=https://your-frontend-domain.example,http://localhost:8000,http://127.0.0.1:8000
# FRONTEND_ORIGIN=https://your-frontend-domain.example

# Runtime tuning, optional
# ANALYSIS_LLM_MAX_TOKENS=16384
# Also used by _test_call_mcp.py for the MiniMax message max_tokens budget.
# ANALYSIS_MAX_CONCURRENT_RUNS=1
# ANALYSIS_SSE_QUEUE_MAXSIZE=128
# ANALYSIS_STREAM_HEARTBEAT_SECONDS=2
# ANALYSIS_TRACE_CHAR_LIMIT=0
# Set to 0 to disable backend trace truncation for FE-visible agent/tool updates.
# ANALYSIS_VERBOSE_RUNTIME_LOGS=true
# AUTH_CACHE_MAX_ENTRIES=256

# TradingView defaults, optional
# TRADING_VIEW_SYMBOL=BINANCE:BTCUSDT
# TRADING_VIEW_INTERVAL=60
